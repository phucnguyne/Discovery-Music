---
import Layout from '../layouts/Layout.astro';
import TopBar from '../components/TopBar.astro';
import SectionHeader from '../components/SectionHeader.astro';
import AlbumCard from '../components/AlbumCard.astro';
import SearchTracks from '../components/react/SearchTracks';
import { api } from '../lib/api';

export const prerender = false;

const q = Astro.url.searchParams.get('q')?.trim() ?? '';
let results: Awaited<ReturnType<typeof api.search>> = { tracks: [], albums: [], artists: [] };
let apiUnreachable = false;

if (q) {
  try {
    results = await api.search(q);
  } catch {
    apiUnreachable = true;
  }
}
---

<Layout
  title={q ? `“${q}”` : 'Search'}
  description={q ? `Search songs, albums and artists matching “${q}”.` : 'Search the music catalog for songs, albums and artists.'}
>
  <TopBar eyebrow="Search" title={q ? `Results for “${q}”` : 'Search the catalog'} backHref="/" backLabel="home" />

  {!q && <p class="empty-state" role="status">Type a song, artist, or album into the search box above to get started.</p>}

  {
    apiUnreachable && (
      <p class="empty-state" role="alert">We couldn’t load search results. Please try again shortly.</p>
    )
  }

  {
    q && results.artists.length > 0 && (
      <section class="section">
        <SectionHeader title="Artists" />
        <div class="grid-cards">
          {results.artists.map((a) => (
            <a class="artist-chip" href={`/artist/${a.id}?from=search&q=${encodeURIComponent(q)}`}>
              <span class="artist-chip__avatar" aria-hidden="true">{a.name.slice(0, 1)}</span>
              <span class="artist-chip__name">{a.name}</span>
              <span class="artist-chip__genre">{a.genre}</span>
            </a>
          ))}
        </div>
      </section>
    )
  }

  {
    q && results.tracks.length > 0 && (
      <SearchTracks
        client:load
        query={q}
        initialTracks={results.tracks.slice(0, 10)}
        hasMore={results.tracks.length > 10}
      />
    )
  }

  {
    q && results.albums.length > 0 && (
      <section class="section">
        <SectionHeader title="Albums" />
        <div class="grid-cards">
          {results.albums.map((a) => (
            <AlbumCard
              title={a.title}
              subtitle={a.artistName}
              artwork={a.coverUrl}
              href={`/album/${a.id}?from=search&q=${encodeURIComponent(q)}`}
            />
          ))}
        </div>
      </section>
    )
  }

  {
    q &&
      !apiUnreachable &&
      results.tracks.length === 0 &&
      results.albums.length === 0 &&
      results.artists.length === 0 && (
        <p class="empty-state" role="status">No results for “{q}”. Try a different spelling or a broader term.</p>
      )
  }
</Layout>

<style>
  .artist-chip {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    padding: 16px;
    border-radius: var(--radius-m);
    border: 1px solid var(--line);
    background: var(--ink-soft);
    transition: border-color 0.15s ease, background 0.15s ease;
  }

  .artist-chip:hover {
    border-color: var(--amber-dim);
    background: var(--ink-raised);
  }

  .artist-chip__avatar {
    width: 44px;
    height: 44px;
    border-radius: 999px;
    display: grid;
    place-items: center;
    background: var(--ink-raised);
    color: var(--amber);
    font-family: var(--font-display);
    font-size: 1.1rem;
  }

  .artist-chip__name {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--paper);
  }

  .artist-chip__genre {
    font-size: 0.76rem;
    color: var(--ash-dim);
  }
</style>
