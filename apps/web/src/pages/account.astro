---
import Layout from '../layouts/Layout.astro';
import TopBar from '../components/TopBar.astro';
import AccountForm from '../components/react/AccountForm';

// No SSR auth gate here — see AccountForm.tsx's comment: apps/api and
// apps/web are different domains in prod, so Astro's SSR has no way to
// see the session cookie. AccountForm checks client-side instead and
// redirects to /login itself if there's no one signed in.
---

<Layout title="My account" description="Manage your Discovery Music account." noindex>
  <TopBar eyebrow="Account" title="Account settings" backHref="/profile" backLabel="profile" divider />
  <section class="account-page" aria-label="Account settings">
    <AccountForm client:load />
  </section>
</Layout>

<style>
  .account-page {
    width: min(100%, 900px);
    margin: 0 auto;
  }
</style>