---
import Layout from '../../layouts/Layout.astro';
import TopBar from '../../components/TopBar.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import TrackRow from '../../components/TrackRow.astro';
import VinylArt from '../../components/VinylArt.astro';
import { api } from '../../lib/api';
import { MusicApiError } from '@music/api-client';

export const prerender = false;

const { id } = Astro.params;
if (!id) return Astro.redirect('/404');

let result: Awaited<ReturnType<typeof api.album>> | null = null;
try {
  result = await api.album(id);
} catch (err) {
  if (err instanceof MusicApiError && (err.status === 400 || err.status === 404)) {
    return Astro.redirect('/404');
  }
  throw err;
}

const { album, tracks } = result;
const playableCount = tracks.filter((t) => t.previewUrl).length;
const returnFrom = Astro.url.searchParams.get('from');
const searchQuery = Astro.url.searchParams.get('q')?.trim();
const albumBackHref =
  returnFrom === 'search' && searchQuery
    ? `/search?q=${encodeURIComponent(searchQuery)}`
    : album.artistId
      ? `/artist/${album.artistId}${returnFrom === 'artist' && searchQuery
          ? `?from=search&q=${encodeURIComponent(searchQuery)}`
          : ''}`
      : '/';
const hasSearchReturn = returnFrom === 'search' && Boolean(searchQuery);
const albumBackLabel = hasSearchReturn ? 'search' : album.artistId ? 'artist' : 'home';
const artistHref = album.artistId
  ? `/artist/${album.artistId}${searchQuery ? `?from=search&q=${encodeURIComponent(searchQuery)}` : ''}`
  : undefined;
---

<Layout
  title={`${album.title} album`}
  description={`Explore ${album.title} by ${album.artistName}, view the tracklist and play available previews.`}
>
  <TopBar eyebrow="Album" title={album.title} backHref={albumBackHref} backLabel={albumBackLabel} />

  <section class="album-hero">
    <VinylArt src={album.coverUrl || '/logo-mark.svg'} alt={`${album.title} artwork`} size={150} ring={false} />
    <div>
      {
        artistHref ? (
          <a class="album-hero__artist" href={artistHref}>{album.artistName}</a>
        ) : (
          <p class="album-hero__artist">{album.artistName}</p>
        )
      }
      <p class="album-hero__meta">
        {album.genre}
        {album.genre && ' · '}
        {tracks.length} track{tracks.length === 1 ? '' : 's'}
        {playableCount > 0 && ` · ${playableCount} playable`}
      </p>
    </div>
  </section>

  <section class="section">
    <SectionHeader title="Tracklist" />
    {
      tracks.length > 0 ? (
        <div class="track-list">
          {tracks.map((t, i) => (
            <TrackRow
              index={i + 1}
              title={t.title}
              artist={t.artistName}
              artistId={t.artistId}
              genre={t.genre}
              album={t.albumTitle}
              artwork={t.coverUrl}
              trackId={t.id}
              previewUrl={t.previewUrl}
              durationMs={t.durationMs}
            />
          ))}
        </div>
      ) : (
        <p class="empty-state">No tracks found for this album.</p>
      )
    }
  </section>
</Layout>

<style>
  .album-hero {
    display: flex;
    align-items: center;
    gap: 22px;
    margin-top: 8px;
  }

  .album-hero__artist {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--amber);
  }

  a.album-hero__artist:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .album-hero__meta {
    margin-top: 8px;
    color: var(--ash);
    font-size: 0.92rem;
  }

  .track-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
</style>
