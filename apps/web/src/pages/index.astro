---
import Layout from '../layouts/Layout.astro';
import TopBar from '../components/TopBar.astro';
import Hero from '../components/Hero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import AlbumCard from '../components/AlbumCard.astro';
import TrackRow from '../components/TrackRow.astro';
import { api } from '../lib/api';
import { GENRES } from '@music/types';
import { pickRecommendationSeed } from '@music/domain';

let trending: Awaited<ReturnType<typeof api.trending>> = [];
let newAlbums: Awaited<ReturnType<typeof api.newReleases>> = [];
let apiUnreachable = false;

try {
  [trending, newAlbums] = await Promise.all([api.trending(), api.newReleases()]);
} catch {
  apiUnreachable = true;
}

// Real listening history once signed in (api.listeningHistory never
// throws — [] for logged-out, unreachable API, or genuinely no history
// yet, all of which should fall through to pickRecommendationSeed's own
// cold-start/random path exactly the same way).
const history = await api.listeningHistory(Astro.request.headers.get('cookie'));
const recommendedSeed = pickRecommendationSeed(history, GENRES);
let recommended: Awaited<ReturnType<typeof api.genre>>['tracks'] = [];
try {
  const genreResult = await api.genre(recommendedSeed.slug);
  recommended = genreResult.tracks.slice(0, 8);
} catch {
  apiUnreachable = true;
}

const heroTrack = trending[0] ?? null;
const trendingRest = trending.slice(1, 9);
---

<Layout
  title="Discover music"
  description="Explore trending songs, new album releases, artists and hand-picked music recommendations."
>
  <TopBar eyebrow="Discovery Music" title="Find something to play" />

  {
    apiUnreachable && (
      <p class="empty-state" role="alert">We’re having trouble loading the music catalog. Please try again shortly.</p>
    )
  }

  <Hero track={heroTrack} />

  <section class="section">
    <SectionHeader eyebrow="Right now" title="Trending tracks" />
    {
      trendingRest.length > 0 ? (
        <div class="track-list">
          {trendingRest.map((t, i) => (
            <TrackRow
              index={i + 1}
              title={t.title}
              artist={t.artistName}
              artistId={t.artistId}
              genre={t.genre}
              album={t.albumTitle}
              artwork={t.coverUrl}
              trackId={t.id}
              previewUrl={t.previewUrl}
              durationMs={t.durationMs}
            />
          ))}
        </div>
      ) : (
        !apiUnreachable && <p class="empty-state">No trending tracks to show right now.</p>
      )
    }
  </section>

  <section class="section">
    <SectionHeader eyebrow="Fresh" title="New releases" />
    {
      newAlbums.length > 0 ? (
        <div class="grid-cards">
          {newAlbums.map((a) => (
            <AlbumCard
              title={a.title}
              subtitle={a.artistName}
              artistId={a.artistId}
              artwork={a.coverUrl}
              href={`/album/${a.id}`}
            />
          ))}
        </div>
      ) : (
        !apiUnreachable && <p class="empty-state">No albums to show right now.</p>
      )
    }
  </section>

  <section class="section">
    <SectionHeader title="Browse genres" />
    <div class="chip-row">
      {GENRES.map((g) => (
        <a class="pill" href={`/genre/${g.slug}`}>{g.label}</a>
      ))}
    </div>
  </section>

  <section class="section">
    <SectionHeader
      eyebrow={`Because you might like ${recommendedSeed.label}`}
      title="Recommended for you"
      seeAllHref={`/genre/${recommendedSeed.slug}`}
    />
    {
      recommended.length > 0 ? (
        <div class="grid-cards">
          {recommended.map((t) => (
            <AlbumCard
              title={t.title}
              subtitle={t.artistName}
              artwork={t.coverUrl}
              href={
                t.albumId
                  ? `/album/${encodeURIComponent(t.albumId)}`
                  : `/search?q=${encodeURIComponent(t.title)}`
              }
              playable={
                t.previewUrl
                  ? {
                      id: t.id,
                      artist: t.artistName,
                      artistId: t.artistId,
                      genre: t.genre,
                      album: t.albumTitle,
                      previewUrl: t.previewUrl,
                      durationMs: t.durationMs,
                    }
                  : undefined
              }
            />
          ))}
        </div>
      ) : (
        !apiUnreachable && <p class="empty-state">No recommendations to show right now.</p>
      )
    }
  </section>
</Layout>

<style>
  .track-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
</style>