---
import { getDisplayArtists } from '../lib/artist-display';

interface Props {
  name: string;
  artistId?: string;
}

const { name, artistId } = Astro.props;
const artists = getDisplayArtists(name, artistId);
---

<span>
  {artists.map((artist, index) => (
    <>
      {index > 0 && ', '}
      <a href={artist.href}>{artist.name}</a>
    </>
  ))}
</span>
