---
import VinylArt from './VinylArt.astro';
import ArtistCredits from './ArtistCredits.astro';

interface Props {
  title: string;
  subtitle: string;
  artwork: string;
  artistId?: string;
  href?: string;
  /** Present only for playable tracks; their title and play button start playback. */
  playable?: {
    id: string;
    artist: string;
    artistId?: string;
    genre?: string;
    album?: string;
    previewUrl: string;
    durationMs?: number;
  };
}

const { title, subtitle, artwork, artistId, href, playable } = Astro.props;
const cardId = `card-${Math.random().toString(36).slice(2, 9)}`;
const isExternal = href?.startsWith('http');
---

<article class="album-card">
  <div class="album-card__art">
    <VinylArt src={artwork} alt={`${title} artwork`} trackId={playable?.id} size={168} />
    {
      playable && (
        <button
          class="album-card__play"
          type="button"
          aria-label={`Play ${title} by ${playable.artist}`}
          id={cardId}
          data-play-button
          data-track-id={playable.id}
          data-title={title}
          data-artist={playable.artist}
          data-album={playable.album ?? ''}
          data-artwork={artwork}
          data-preview={playable.previewUrl}
          data-duration={playable.durationMs ?? ''}
          data-artist-id={playable.artistId ?? ''}
          data-genre={playable.genre ?? ''}
        >
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path d="M8 5.5v13l11-6.5-11-6.5z" fill="currentColor" />
          </svg>
        </button>
      )
    }
  </div>
  <div class="album-card__meta">
    {
      playable ? (
        <button
          class="album-card__title album-card__title--play"
          type="button"
          aria-label={`Play ${title} by ${playable.artist}`}
          data-play-button
          data-track-id={playable.id}
          data-title={title}
          data-artist={playable.artist}
          data-album={playable.album ?? ''}
          data-artwork={artwork}
          data-preview={playable.previewUrl}
          data-duration={playable.durationMs ?? ''}
          data-artist-id={playable.artistId ?? ''}
          data-genre={playable.genre ?? ''}
        >
          {title}
        </button>
      ) : href ? (
        <a
          class="album-card__title"
          href={href}
          target={isExternal ? '_blank' : undefined}
          rel={isExternal ? 'noopener noreferrer' : undefined}
        >
          {title}
        </a>
      ) : (
        <p class="album-card__title">{title}</p>
      )
    }
    <div class="album-card__subtitle">
      <ArtistCredits name={subtitle} artistId={playable?.artistId ?? artistId} />
    </div>
  </div>
</article>

<style>
  .album-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .album-card__art {
    position: relative;
    width: 100%;
  }

  .album-card__art :global(.vinyl) {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
  }

  .album-card__art :global(.vinyl__art) {
    width: 100%;
    height: 100%;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .album-card:hover .album-card__art :global(.vinyl__art) {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card);
  }

  .album-card__play {
    position: absolute;
    right: 10px;
    bottom: 10px;
    z-index: 3;
    width: 38px;
    height: 38px;
    border-radius: 999px;
    display: grid;
    place-items: center;
    background: var(--amber);
    color: var(--ink);
    box-shadow: 0 8px 18px -8px rgba(23, 21, 29, 0.28);
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.15s ease, transform 0.15s ease, background 0.15s ease;
  }

  .album-card:hover .album-card__play,
  .album-card:focus-within .album-card__play {
    opacity: 1;
    transform: translateY(0);
  }

  .album-card__play:hover {
    background: var(--violet);
  }

  .album-card__meta {
    display: block;
    min-width: 0;
  }

  .album-card__title {
    display: block;
    width: 100%;
    padding: 0;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--paper);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .album-card__subtitle {
    display: block;
    margin-top: 3px;
    font-size: 0.82rem;
    color: var(--ash);
  }

  .album-card__subtitle :global(a:hover) {
    color: var(--amber);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  a.album-card__title:hover,
  button.album-card__title:hover {
    color: var(--amber);
  }

  button.album-card__title {
    border: 0;
    background: transparent;
    cursor: pointer;
    font-family: inherit;
    text-align: left;
  }

  .album-card__title--play:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>