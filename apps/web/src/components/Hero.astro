---
import VinylArt from './VinylArt.astro';
import { formatDuration } from '../lib/format';
import type { Track } from '@music/types';

interface Props {
  track: Track | null;
}
const { track } = Astro.props;
const artwork = track?.coverUrl ?? '';
---

{
  track && (
    <section class="hero">
      <div class="hero__copy">
        <span class="hero__eyebrow">No. 1 on today's chart</span>
        <h1 class="hero__title">{track.title}</h1>
        <p class="hero__artist">{track.artistName}{track.albumTitle ? ` — ${track.albumTitle}` : ''}</p>
        <div class="hero__row">
          {track.previewUrl && (
            <button
              class="hero__play"
              type="button"
              data-play-button
              data-track-id={track.id}
              data-title={track.title}
              data-artist={track.artistName}
              data-album={track.albumTitle ?? ''}
              data-artwork={artwork}
              data-preview={track.previewUrl}
              data-duration={track.durationMs ?? ''}
              data-artist-id={track.artistId}
              data-genre={track.genre ?? ''}
            >
              <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
                <path d="M8 5.5v13l11-6.5-11-6.5z" fill="currentColor" />
              </svg>
              Play preview
            </button>
          )}
          <span class="hero__meta">
            {track.genre} · {formatDuration(track.durationMs)}
          </span>
        </div>
      </div>
      <div class="hero__panel">
        <VinylArt src={artwork} alt={`${track.title} artwork`} trackId={track.id} size={220} />
      </div>
    </section>
  )
}

<style>
  .hero {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    gap: 0;
    border-radius: var(--radius-l);
    background: var(--ink-soft);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }

  .hero__copy {
    max-width: 440px;
    padding: 36px 40px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hero__eyebrow {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--amber-dim);
    margin-bottom: 14px;
  }

  .hero__title {
    font-size: clamp(1.9rem, 3.4vw, 2.6rem);
    line-height: 1.08;
    color: var(--paper);
  }

  .hero__artist {
    margin-top: 12px;
    color: var(--ash);
    font-size: 1.02rem;
  }

  .hero__row {
    margin-top: 26px;
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }

  .hero__play {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    background: var(--paper);
    color: var(--ink);
    font-weight: 600;
    font-size: 0.88rem;
    padding: 11px 22px;
    border-radius: 999px;
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .hero__play:hover {
    background: var(--amber);
    color: var(--ink-soft);
    transform: translateY(-1px);
  }

  .hero__meta {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--ash-dim);
  }

  .hero__panel {
    flex: none;
    width: 320px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(150deg, #14c3b8 0%, #6a5cff 55%, #ff4d8d 100%);
    position: relative;
  }

  @media (max-width: 760px) {
    .hero {
      flex-direction: column-reverse;
    }
    .hero__copy {
      max-width: none;
      padding: 26px 24px;
    }
    .hero__panel {
      width: 100%;
      height: 200px;
    }
  }
</style>