---
import { formatDuration } from '../lib/format';

interface Props {
  index?: number;
  title: string;
  artist: string;
  artistId: string;
  genre?: string;
  album?: string;
  artwork: string;
  trackId: string;
  previewUrl?: string;
  durationMs?: number;
}

const { index, title, artist, artistId, genre, album, artwork, trackId, previewUrl, durationMs } = Astro.props;
const playable = Boolean(previewUrl);
---

<div class="track-row" data-vinyl data-track-id={trackId}>
  {typeof index === 'number' && <span class="track-row__index">{String(index).padStart(2, '0')}</span>}
  <img class="track-row__art" src={artwork} alt="" loading="lazy" width="44" height="44" />
  <div class="track-row__meta">
    <p class="track-row__title">{title}</p>
    <p class="track-row__artist">{artist}</p>
  </div>
  <span class="track-row__duration">{formatDuration(durationMs)}</span>

  <button
    class="track-row__icon-btn"
    type="button"
    aria-label={`Add ${title} to a playlist`}
    data-add-to-playlist-button
    data-track-id={trackId}
    data-title={title}
    data-artist={artist}
    data-album={album ?? ''}
    data-artwork={artwork}
    data-preview={previewUrl ?? ''}
    data-duration={durationMs ?? ''}
    data-artist-id={artistId}
    data-genre={genre ?? ''}
  >
    <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
      <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
    </svg>
  </button>

  <button
    class="track-row__icon-btn track-row__favorite"
    type="button"
    aria-label={`Favorite ${title} by ${artist}`}
    aria-pressed="false"
    data-favorite-button
    data-track-id={trackId}
    data-title={title}
    data-artist={artist}
    data-album={album ?? ''}
    data-artwork={artwork}
    data-preview={previewUrl ?? ''}
    data-duration={durationMs ?? ''}
    data-artist-id={artistId}
    data-genre={genre ?? ''}
  >
    <svg class="track-row__heart-outline" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
      <path
        d="M12 20.5s-7.5-4.7-10-9.3C.5 8 2 4.5 5.5 4 8 3.6 10 5 12 7.3 14 5 16 3.6 18.5 4 22 4.5 23.5 8 22 11.2c-2.5 4.6-10 9.3-10 9.3z"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linejoin="round"
      />
    </svg>
    <svg class="track-row__heart-filled" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
      <path
        d="M12 20.5s-7.5-4.7-10-9.3C.5 8 2 4.5 5.5 4 8 3.6 10 5 12 7.3 14 5 16 3.6 18.5 4 22 4.5 23.5 8 22 11.2c-2.5 4.6-10 9.3-10 9.3z"
        fill="currentColor"
      />
    </svg>
  </button>

  {
    playable ? (
      <button
        class="track-row__play"
        type="button"
        aria-label={`Play ${title} by ${artist}`}
        data-play-button
        data-track-id={trackId}
        data-title={title}
        data-artist={artist}
        data-album={album ?? ''}
        data-artwork={artwork}
        data-preview={previewUrl}
        data-duration={durationMs ?? ''}
        data-artist-id={artistId}
        data-genre={genre ?? ''}
      >
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <path d="M8 5.5v13l11-6.5-11-6.5z" fill="currentColor" />
        </svg>
      </button>
    ) : (
      <span class="track-row__play track-row__play--disabled" aria-hidden="true">
        —
      </span>
    )
  }
</div>

<style>
  .track-row {
    display: grid;
    grid-template-columns: 26px 44px 1fr auto 32px 32px 36px;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-radius: var(--radius-m);
    transition: background 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
  }

  .track-row:hover {
    background: var(--ink-soft);
    box-shadow: var(--shadow-edge);
    transform: translateY(-1px);
  }

  .track-row.is-playing {
    background: var(--ink-soft);
    box-shadow: var(--shadow-edge);
  }

  .track-row.is-playing .track-row__title {
    color: var(--amber);
  }

  .track-row__index {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ash-dim);
    text-align: right;
  }

  .track-row__art {
    width: 44px;
    height: 44px;
    border-radius: 6px;
    object-fit: cover;
  }

  .track-row__meta {
    min-width: 0;
  }

  .track-row__title {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--paper);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .track-row__artist {
    margin-top: 2px;
    font-size: 0.8rem;
    color: var(--ash);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .track-row__duration {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ash-dim);
  }

  .track-row__icon-btn {
    width: 30px;
    height: 30px;
    border-radius: 999px;
    display: grid;
    place-items: center;
    color: var(--ash-dim);
    opacity: 0;
    transition: color 0.15s ease, background 0.15s ease, opacity 0.15s ease;
  }

  .track-row:hover .track-row__icon-btn,
  .track-row__icon-btn:focus-visible {
    opacity: 1;
  }

  .track-row__icon-btn:hover {
    color: var(--paper);
    background: var(--ink-raised);
  }

  .track-row__favorite {
    position: relative;
  }

  .track-row__heart-filled {
    display: none;
    color: #ef4a6b;
  }

  .track-row__favorite[aria-pressed='true'] {
    opacity: 1;
    color: #ef4a6b;
  }

  .track-row__favorite[aria-pressed='true'] .track-row__heart-outline {
    display: none;
  }

  .track-row__favorite[aria-pressed='true'] .track-row__heart-filled {
    display: block;
  }

  .track-row__play {
    width: 32px;
    height: 32px;
    border-radius: 999px;
    display: grid;
    place-items: center;
    color: var(--ash);
    transition: color 0.15s ease, background 0.15s ease;
  }

  .track-row__play:hover {
    color: var(--ink);
    background: var(--amber);
  }

  .track-row__play--disabled {
    color: var(--ash-dim);
    cursor: default;
  }
</style>